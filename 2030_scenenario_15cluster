        ]
    )

    ax.set_ylabel("Energy [TWh/a]")

    ax.set_xlabel("")

    ax.grid(axis="y")

    ax.legend(handles, labels, ncol=4, loc="upper left")

    fig_energy.tight_layout()

    if fn is not None:
        fig_energy.savefig(fn, transparent=True)


if __name__ == "__main__":
