        e_nom_max=np.inf,
        capital_cost=options["co2_sequestration_cost"],
        carrier="co2 stored",
        bus=spatial.co2.nodes,
    )

    if co2_network:

        logger.info("Adding CO2 network.")
        co2_links = create_network_topology(n, "CO2 pipeline ")

