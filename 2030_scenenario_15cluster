            sep=",",
            header=0,
            keep_default_na=False,  # , index_col=0
        )
        geo_locs = geo_locs[geo_locs["country"].isin(countries)]
        geo_locs["capacity"] = pd.to_numeric(geo_locs.capacity)

        # Call the function to add the "industry" column
